    "@payloadcms/plugin-sentry": "^3.89.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "@payloadcms/translations": "^3.89.0",
    "cli-color": "^2.0.4",
    "env-cmd": "^10.1.0",
    "graphql": "^16.9.0",
    "lru-cache": "^9.1.1",
    "lucide-react": "^0.525.0",
    "next": "15.4.11",
    "payload": "^3.0.0",
    "pg": "^8.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
