    "@typescript-eslint/parser": "^8.1.0",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.14",
    "csv-parse": "^7.0.2",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.3.1",
