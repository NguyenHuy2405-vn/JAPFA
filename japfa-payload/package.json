{
  "name": "japfa-payload",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "local": "env-cmd -f .env.local next dev -p 3010",
    "dev": "next dev -p 3010",
    "build": "next build",
    "build-server": "NODE_OPTIONS=--max-old-space-size=8192 next build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "start": "bash ./start.sh",
    "local:japfa": "npm run local",
    "build:japfa": "npm run build",
    "payload": "payload",
    "payload:migrate:create": "payload migrate:create",
    "payload:migrate": "payload migrate",
    "payload:migrate:status": "payload migrate:status",
    "migrate:csv": "env-cmd -f .env.local tsx src/migrateCsv.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "cli-color": "^2.0.4",
    "env-cmd": "^10.1.0",
    "graphql": "^16.9.0",
    "lru-cache": "^9.1.1",
    "lucide-react": "^0.525.0",
    "next": "^15.2.0",
    "payload": "^3.0.0",
    "pg": "^8.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.2.0",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.8",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.1.0",
    "@typescript-eslint/parser": "^8.1.0",
    "autoprefixer": "^10.4.14",
    "csv-parse": "^7.0.2",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.3.1",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4"
  }
}
